class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


class CreateList:
    def __init__(self):
        self.head = None
        self.tail = None

    def add(self, data):
        new_node = Node(data)
        if self.head is None:
            self.head = new_node
            self.tail = new_node
            self.tail.next = self.head
        else:
            self.tail.next = new_node
            self.tail = new_node
            self.tail.next = self.head

    def display(self):
        if self.head is None:
            print("List is empty")
            return

        current = self.head
        print("Nodes of the circular linked list:")
        while True:
            print(current.data)
            current = current.next
            if current == self.head:
                break


if _name_ == "_main_":
    c1 = CreateList()
    c1.add(1)
    c1.add(2)
    c1.add(3)
    c1.add(4)
    c1.display()
