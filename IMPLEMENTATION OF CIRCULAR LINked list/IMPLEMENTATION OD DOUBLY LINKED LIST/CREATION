class Node:
	def __init__(self, data):
		self.data = data
		self.previous = None
		self.next = None


class CountList:
	def __init__(self):
		self.head = None
		self.tail = None

	def addNode(self, data):
		new_node = Node(data)
		if self.head is None:
			self.head = self.tail = new_node
			return

		self.tail.next = new_node
		new_node.previous = self.tail
		self.tail = new_node

	def countNodes(self):
		counter = 0
		current = self.head
		while current is not None:
			counter += 1
			current = current.next
		return counter

	def display(self):
		if self.head is None:
			print("List is empty")
			return

		current = self.head
		print("Nodes of doubly linked list:")
		while current is not None:
			print(current.data)
			current = current.next


if __name__ == "__main__":
	d_list = CountList()
	for value in range(1, 6):
		d_list.addNode(value)
	d_list.display()
	print("\nCount of nodes present in the list: " + str(d_list.countNodes()))
