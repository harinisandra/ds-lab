class Node:
    def __init__(self,data):
        self.data=data
        self.next=None  
class CircularLinkedList:
    def __init__(self):
        self.head = None 
    def push(self, data): 
        ptr1 = Node(data)
        temp = self.head
        ptr1.next = self.head
        if self.head is not None:
            while(temp.next != self.head):
                temp = temp.next
            temp.next = ptr1 
        else:
            ptr1.next = ptr1
            self.head = ptr1
    def printList(self):
        temp=self.head
        if self.head is not None:
            while True:
                print("%d" % (temp.data))
                temp = temp.next 
                if(temp == self.head):
                    break
c1list=CircularLinkedList()
c1list.push(12)
c1list.push(56)
c1list.push(2) 
c1list.push(11) 
print("Contents of circular Linked List") 
c1list.printList()
